-- STEP 7: Execution for Second Cursor (Conditional Salary Updates)
-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
DECLARE @Counter INT =3D 1;
DECLARE @TotalRaise DECIMAL(10,2) =3D 0;

DECLARE emp_update_cursor CURSOR FOR
SELECT EmployeeID, Salary
FROM Employees
WHERE DATEDIFF(YEAR, HireDate, GETDATE()) &gt;=3D 2;

OPEN emp_update_cursor;

DECLARE @U_EmpID INT;
DECLARE @CurrentSalary DECIMAL(10,2);

FETCH NEXT FROM emp_update_cursor INTO @U_EmpID, @CurrentSalary;

WHILE @@FETCH_STATUS =3D 0
BEGIN
    DECLARE @NewSalary DECIMAL(10,2) =3D @CurrentSalary * 1.05;
    DECLARE @RaiseAmount DECIMAL(10,2) =3D @NewSalary - @CurrentSalary;
   =20
    UPDATE Employees
    SET Salary =3D @NewSalary
    WHERE EmployeeID =3D @U_EmpID;
   =20
    SET @TotalRaise =3D @TotalRaise + @RaiseAmount;
    SET @Counter =3D @Counter + 1;
   =20
    FETCH NEXT FROM emp_update_cursor INTO @U_EmpID, @CurrentSalary;
END

CLOSE emp_update_cursor;
DEALLOCATE emp_update_cursor;

PRINT 'Total Employees Updated: ' + CAST(@Counter - 1 AS NVARCHAR(10));
PRINT 'Total Raise Amount: ' + CAST(@TotalRaise AS NVARCHAR(20));

PRINT 'EXERCISE 7: Triggers &amp; Cursors Completed';
