CREATE TABLE Employees (
    EmployeeID INT PRIMARY KEY IDENTITY(1,1),
    FirstName NVARCHAR(50),
    LastName NVARCHAR(50),
    Department NVARCHAR(50),
    Salary DECIMAL(10,2),
    HireDate DATE
);
INSERT INTO Employees VALUES
('John', 'Smith', 'Sales', 50000, '2020-01-15'),
('Jane', 'Doe', 'Sales', 55000, '2019-03-20'),
('Mike', 'Johnson', 'IT', 75000, '2018-06-10'),
('Sarah', 'Williams', 'IT', 80000, '2021-02-05'),
('Tom', 'Brown', 'HR', 45000, '2022-07-12'),
('Lisa', 'Davis', 'HR', 48000, '2020-11-08'),
('Bob', 'Miller', 'Sales', 52000, '2021-05-18'),
('Carol', 'Wilson', 'IT', 78000, '2019-09-25');
SELECT * FROM Employees;
SELECT=20
    FirstName,
    LastName,
    Department,
    Salary,
    ROW_NUMBER() OVER (ORDER BY Salary DESC) AS RowNum,
    RANK() OVER (ORDER BY Salary DESC) AS Rank,
    DENSE_RANK() OVER (ORDER BY Salary DESC) AS DenseRank
FROM Employees;
SELECT=20
    FirstName,
    LastName,
    Department,
    Salary,
    ROW_NUMBER() OVER (PARTITION BY Department ORDER BY Salary DESC) AS Row=
NumInDept,
    AVG(Salary) OVER (PARTITION BY Department) AS DepartmentAvgSalary,
    LAG(Salary) OVER (PARTITION BY Department ORDER BY HireDate) AS Previou=
sSalary,
    LEAD(Salary) OVER (PARTITION BY Department ORDER BY HireDate) AS NextSa=
lary
FROM Employees;
SELECT=20
    FirstName,
    LastName,
    Department,
    Salary,
    SUM(Salary) OVER (PARTITION BY Department) AS DepartmentTotal,
    COUNT(*) OVER (PARTITION BY Department) AS DepartmentCount,
    MIN(Salary) OVER (PARTITION BY Department) AS DepartmentMin,
    MAX(Salary) OVER (PARTITION BY Department) AS DepartmentMax
FROM Employees;
SELECT=20
    FirstName,
    LastName,
    Department,
    Salary,
    PERCENT_RANK() OVER (PARTITION BY Department ORDER BY Salary DESC) AS P=
ercentRank,
    NTILE(4) OVER (ORDER BY Salary DESC) AS Quartile
FROM Employees;
SELECT=20
    Department,
    FirstName,
    LastName,
    Salary,
    FIRST_VALUE(FirstName) OVER (PARTITION BY Department ORDER BY Salary DE=
SC) AS HighestPaidEmployee,
    LAST_VALUE(FirstName) OVER (PARTITION BY Department ORDER BY Salary DES=
C=20
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS Lowest=
PaidEmployee
FROM Employees;
SELECT=20
    FirstName,
    LastName,
    Department,
    Salary,
    CUME_DIST() OVER (ORDER BY Salary DESC) AS CumulativeDist,
    SUM(Salary) OVER (ORDER BY HireDate ROWS BETWEEN UNBOUNDED PRECEDING AN=
D CURRENT ROW) AS RunningTotal
FROM Employees;
