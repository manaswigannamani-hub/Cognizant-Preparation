-- 1. VIEWS: Virtual tables for simplifying complex data access
-- Wrapped in EXEC to force a new batch
EXEC('
CREATE VIEW EmployeeSalaryView AS
SELECT=20
    EmployeeID,
    FirstName,
    LastName,
    Department,
    Salary,
    CASE=20
        WHEN Salary &gt;=3D 75000 THEN ''Senior''
        WHEN Salary &gt;=3D 55000 THEN ''Mid-Level''
        ELSE ''Junior''
    END AS SalaryLevel
FROM Employees;
');

EXEC('
CREATE VIEW DepartmentSummary AS
SELECT=20
    Department,
    COUNT(*) AS EmployeeCount,
    AVG(Salary) AS AvgSalary,
    MIN(Salary) AS MinSalary,
    MAX(Salary) AS MaxSalary,
    SUM(Salary) AS TotalSalary
FROM Employees
GROUP BY Department;
');

-- Query the views to view results
SELECT * FROM EmployeeSalaryView;
SELECT * FROM DepartmentSummary;


-- 2. INDEXES: Speeding up query searches
CREATE INDEX IX_Employees_Department ON Employees(Department);
CREATE INDEX IX_Employees_Salary ON Employees(Salary DESC);
CREATE INDEX IX_Employees_DeptSalary ON Employees(Department, Salary);
CREATE UNIQUE INDEX IX_Employees_Email ON Employees(EmployeeID);

-- Check metadata system table to verify index structures exist
SELECT name, type_desc, is_unique FROM sys.indexes WHERE object_id =3D OBJE=
CT_ID('Employees');


-- 3. STORED PROCEDURES: Packaged script modules with inputs/outputs
EXEC('
CREATE PROCEDURE sp_GetEmployeesByDepartment
    @Department NVARCHAR(50)
AS
BEGIN
    SELECT EmployeeID, FirstName, LastName, Department, Salary
    FROM Employees
    WHERE Department =3D @Department
    ORDER BY Salary DESC;
END;
');

-- Execute Procedure A
EXEC sp_GetEmployeesByDepartment @Department =3D 'IT';

EXEC('
CREATE PROCEDURE sp_GetEmployeeRaiseEligible
    @RaisePercentage DECIMAL(5,2) =3D 10
AS
BEGIN
    SELECT=20
        EmployeeID, FirstName, LastName, Salary,
        ROUND(Salary * (@RaisePercentage / 100), 2) AS RaiseAmount,
        Salary + ROUND(Salary * (@RaisePercentage / 100), 2) AS NewSalary
    FROM Employees
    WHERE DATEDIFF(YEAR, HireDate, GETDATE()) &gt;=3D 2;
END;
');

-- Execute Procedure B
EXEC sp_GetEmployeeRaiseEligible @RaisePercentage =3D 5;


-- 4. FUNCTIONS (Scalar and Table-Valued)
EXEC('
CREATE FUNCTION fn_GetEmployeeAge(@EmployeeID INT)
RETURNS INT
AS
BEGIN
    DECLARE @Age INT;
    SELECT @Age =3D DATEDIFF(YEAR, HireDate, GETDATE())
    FROM Employees
    WHERE EmployeeID =3D @EmployeeID;
    RETURN @Age;
END;
');

-- Query Scalar Function (Must use the schema ''dbo.'' prefix constraint)
SELECT EmployeeID, FirstName, LastName, dbo.fn_GetEmployeeAge(EmployeeID) A=
S YearsWithCompany FROM Employees;

EXEC('
CREATE FUNCTION fn_GetEmployeesByDepartmentTVF(@Department NVARCHAR(50))
RETURNS TABLE
AS
RETURN
(
    SELECT EmployeeID, FirstName, LastName, Salary
    FROM Employees
    WHERE Department =3D @Department
);
');

-- Query the TVF
SELECT * FROM dbo.fn_GetEmployeesByDepartmentTVF('Sales');
