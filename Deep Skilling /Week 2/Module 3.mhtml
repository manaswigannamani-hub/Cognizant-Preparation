EXEC('
CREATE FUNCTION fn_CalculateBonus(@Salary DECIMAL(10,2), @Years INT)
RETURNS DECIMAL(10,2)
AS
BEGIN
    DECLARE @Bonus DECIMAL(10,2);
    SET @Bonus =3D CASE=20
        WHEN @Years &gt;=3D 5 THEN @Salary * 0.15
        WHEN @Years &gt;=3D 3 THEN @Salary * 0.10
        WHEN @Years &gt;=3D 1 THEN @Salary * 0.05
        ELSE 0
    END;   =20
    RETURN @Bonus;
END;
');
-- Query using the bonus calculation function
SELECT=20
    FirstName,
    LastName,
    Salary,
    DATEDIFF(YEAR, HireDate, GETDATE()) AS YearsService,
    dbo.fn_CalculateBonus(Salary, DATEDIFF(YEAR, HireDate, GETDATE())) AS B=
onusAmount
FROM Employees;
EXEC('
CREATE FUNCTION fn_FormatEmployeeName(@FirstName NVARCHAR(50), @LastName NV=
ARCHAR(50))
RETURNS NVARCHAR(101)
AS
BEGIN
    RETURN UPPER(@LastName) + '', '' + @FirstName;
END;
');
-- Query using the name formatting function
SELECT=20
    EmployeeID,
    dbo.fn_FormatEmployeeName(FirstName, LastName) AS FullName,
    Department
FROM Employees;
EXEC('
CREATE FUNCTION fn_GetDepartmentStats(@Department NVARCHAR(50))
RETURNS TABLE
AS
RETURN
(
    SELECT=20
        @Department AS Department,
        COUNT(*) AS TotalEmployees,
        AVG(Salary) AS AvgSalary,
        MIN(Salary) AS MinSalary,
        MAX(Salary) AS MaxSalary
    FROM Employees
    WHERE Department =3D @Department
    GROUP BY Department
);
');
-- Query using the table-valued statistics function
SELECT * FROM dbo.fn_GetDepartmentStats('Sales');
EXEC('
CREATE PROCEDURE sp_DepartmentReport
    @Department NVARCHAR(50) =3D NULL
AS
BEGIN
    IF @Department IS NULL
    BEGIN
        SELECT=20
            Department,
            COUNT(*) AS EmployeeCount,
            AVG(Salary) AS AvgSalary
        FROM Employees
        GROUP BY Department;
    END
    ELSE
    BEGIN
        SELECT=20
            EmployeeID,
            FirstName,
            LastName,
            Salary
        FROM Employees
        WHERE Department =3D @Department
        ORDER BY Salary DESC;
    END
END;
');

-- Test Procedure calls
EXEC sp_DepartmentReport;
EXEC sp_DepartmentReport @Department =3D 'IT';
EXEC('
CREATE PROCEDURE sp_AddEmployee
    @FirstName NVARCHAR(50),
    @LastName NVARCHAR(50),
    @Department NVARCHAR(50),
    @Salary DECIMAL(10,2),
    @NewEmployeeID INT OUTPUT
AS
BEGIN
    BEGIN TRY
        IF @FirstName IS NULL OR @LastName IS NULL
        BEGIN
            THROW 50001, ''First and Last names are required'', 1;
        END
       =20
        IF @Salary &lt; 30000
        BEGIN
            THROW 50002, ''Salary must be at least 30000'', 1;
        END
       =20
        INSERT INTO Employees (FirstName, LastName, Department, Salary, Hir=
eDate)
        VALUES (@FirstName, @LastName, @Department, @Salary, GETDATE());
       =20
        SET @NewEmployeeID =3D SCOPE_IDENTITY();
    END TRY
    BEGIN CATCH
        PRINT ''Error: '' + ERROR_MESSAGE();
        SET @NewEmployeeID =3D -1;
    END CATCH
END;
');

-- Execute the write operation procedure and check output parameter
DECLARE @EmpID INT;
EXEC sp_AddEmployee=20
    @FirstName =3D 'James',
    @LastName =3D 'Anderson',
    @Department =3D 'Finance',
    @Salary =3D 65000,
    @NewEmployeeID =3D @EmpID OUTPUT;

PRINT 'New Employee ID: ' + CAST(@EmpID AS NVARCHAR(10));

PRINT 'EXERCISE 6: User-Defined Functions &amp; Procedures Completed';
