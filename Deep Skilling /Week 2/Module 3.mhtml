-- STEP 6: Table Setup &amp; Execution for First Cursor (Employee Data Migr=
ation)
-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
CREATE TABLE EmployeeCursor (
    EmployeeID INT,
    FirstName NVARCHAR(50),
    LastName NVARCHAR(50),
    Department NVARCHAR(50),
    Salary DECIMAL(10,2)
);

DECLARE @EmpID INT;
DECLARE @FName NVARCHAR(50);
DECLARE @LName NVARCHAR(50);
DECLARE @Dept NVARCHAR(50);
DECLARE @Sal DECIMAL(10,2);

DECLARE emp_cursor CURSOR FOR
SELECT EmployeeID, FirstName, LastName, Department, Salary
FROM Employees;

OPEN emp_cursor;

FETCH NEXT FROM emp_cursor INTO @EmpID, @FName, @LName, @Dept, @Sal;

WHILE @@FETCH_STATUS =3D 0
BEGIN
    INSERT INTO EmployeeCursor VALUES (@EmpID, @FName, @LName, @Dept, @Sal)=
;
   =20
    FETCH NEXT FROM emp_cursor INTO @EmpID, @FName, @LName, @Dept, @Sal;
END

CLOSE emp_cursor;
DEALLOCATE emp_cursor;

SELECT * FROM EmployeeCursor;


-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
