EXEC('
CREATE PROCEDURE sp_IsolationLevelDemo
    @IsolationLevel NVARCHAR(50)
AS
BEGIN
    BEGIN TRY
        IF @IsolationLevel =3D ''SERIALIZABLE''
            SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
        ELSE IF @IsolationLevel =3D ''REPEATABLE''
            SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
        ELSE IF @IsolationLevel =3D ''COMMITTED''
            SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
        ELSE IF @IsolationLevel =3D ''UNCOMMITTED''
            SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
       =20
        BEGIN TRANSACTION;
       =20
        DECLARE @Count INT;
        SELECT @Count =3D COUNT(*) FROM Employees WHERE Salary &gt; 50000;
       =20
        WAITFOR DELAY ''00:00:02'';
       =20
        SELECT @Count;
       =20
        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;
        PRINT ''Error: '' + ERROR_MESSAGE();
    END CATCH
END;
');

EXEC('
CREATE PROCEDURE sp_DeadlockRetry
    @FromAccount INT,
    @ToAccount INT,
    @Amount DECIMAL(15,2),
    @MaxRetries INT =3D 3
AS
BEGIN
    DECLARE @RetryCount INT =3D 0;
    DECLARE @Success INT =3D 0;
   =20
    WHILE @RetryCount &lt; @MaxRetries AND @Success =3D 0
    BEGIN
        BEGIN TRY
            BEGIN TRANSACTION;
           =20
            UPDATE AccountBalance SET Balance =3D Balance - @Amount WHERE A=
ccountID =3D @FromAccount;
            UPDATE AccountBalance SET Balance =3D Balance + @Amount WHERE A=
ccountID =3D @ToAccount;
           =20
            COMMIT TRANSACTION;
            SET @Success =3D 1;
            PRINT ''Transaction succeeded on attempt '' + CAST(@RetryCount =
+ 1 AS NVARCHAR(10));
        END TRY
        BEGIN CATCH
            IF ERROR_NUMBER() =3D 1205
            BEGIN
                SET @RetryCount =3D @RetryCount + 1;
                PRINT ''Deadlock detected. Retry attempt '' + CAST(@RetryCo=
unt AS NVARCHAR(10));
                ROLLBACK TRANSACTION;
                WAITFOR DELAY ''00:00:01'';
            END
            ELSE
            BEGIN
                ROLLBACK TRANSACTION;
                THROW;
            END
        END CATCH
    END
   =20
    IF @Success =3D 0
    BEGIN
        THROW 50009, ''Transaction failed after maximum retries'', 1;
    END
END;
');
