EXEC('
CREATE PROCEDURE sp_WithExceptionHandling
    @EmployeeID INT,
    @NewSalary DECIMAL(10,2)
AS
BEGIN
    BEGIN TRY
        IF @EmployeeID &lt;=3D 0
        BEGIN
            THROW 50001, ''Invalid Employee ID'', 1;
        END
       =20
        IF @NewSalary &lt; 30000
        BEGIN
            THROW 50002, ''Salary must be at least 30000'', 1;
        END
       =20
        IF NOT EXISTS (SELECT 1 FROM Employees WHERE EmployeeID =3D @Employ=
eeID)
        BEGIN
            THROW 50003, ''Employee not found'', 1;
        END
       =20
        UPDATE Employees
        SET Salary =3D @NewSalary
        WHERE EmployeeID =3D @EmployeeID;
       =20
        PRINT ''Salary updated successfully'';
    END TRY
    BEGIN CATCH
        PRINT ''Error Number: '' + CAST(ERROR_NUMBER() AS NVARCHAR(10));
        PRINT ''Error Message: '' + ERROR_MESSAGE();
        PRINT ''Error Severity: '' + CAST(ERROR_SEVERITY() AS NVARCHAR(10))=
;
        PRINT ''Error State: '' + CAST(ERROR_STATE() AS NVARCHAR(10));
    END CATCH
END;
');

EXEC sp_WithExceptionHandling @EmployeeID =3D 1, @NewSalary =3D 60000;
EXEC sp_WithExceptionHandling @EmployeeID =3D 1, @NewSalary =3D 20000;

EXEC('
CREATE PROCEDURE sp_TransferEmployees
    @FromDept NVARCHAR(50),
    @ToDept NVARCHAR(50)
AS
BEGIN
    BEGIN TRANSACTION;
    BEGIN TRY
        UPDATE Employees
        SET Department =3D @ToDept
        WHERE Department =3D @FromDept;
       =20
        DECLARE @UpdatedRows INT =3D @@ROWCOUNT;
       =20
        IF @UpdatedRows =3D 0
        BEGIN
            THROW 50004, ''No employees found in source department'', 1;
        END
       =20
        COMMIT TRANSACTION;
        PRINT ''Transaction committed. '' + CAST(@UpdatedRows AS NVARCHAR(1=
0)) + '' employees transferred.'';
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;
        PRINT ''Transaction rolled back. Error: '' + ERROR_MESSAGE();
    END CATCH
END;
');

EXEC sp_TransferEmployees @FromDept =3D 'Sales', @ToDept =3D 'Marketing';

