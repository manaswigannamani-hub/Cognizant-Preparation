EXEC('
CREATE PROCEDURE sp_TransferMoney
    @FromAccount INT,
    @ToAccount INT,
    @Amount DECIMAL(15,2)
AS
BEGIN
    BEGIN TRANSACTION;
    BEGIN TRY
        SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
       =20
        IF @Amount &lt;=3D 0
        BEGIN
            THROW 50005, ''Amount must be greater than 0'', 1;
        END
       =20
        IF NOT EXISTS (SELECT 1 FROM AccountBalance WHERE AccountID =3D @Fr=
omAccount)
        BEGIN
            THROW 50006, ''Source account not found'', 1;
        END
       =20
        IF NOT EXISTS (SELECT 1 FROM AccountBalance WHERE AccountID =3D @To=
Account)
        BEGIN
            THROW 50007, ''Destination account not found'', 1;
        END
       =20
        DECLARE @FromBalance DECIMAL(15,2);
        SELECT @FromBalance =3D Balance FROM AccountBalance WHERE AccountID=
 =3D @FromAccount;
       =20
        IF @FromBalance &lt; @Amount
        BEGIN
            THROW 50008, ''Insufficient funds'', 1;
        END
       =20
        UPDATE AccountBalance
        SET Balance =3D Balance - @Amount
        WHERE AccountID =3D @FromAccount;
       =20
        UPDATE AccountBalance
        SET Balance =3D Balance + @Amount
        WHERE AccountID =3D @ToAccount;
       =20
        COMMIT TRANSACTION;
        PRINT ''Transfer successful. '' + CAST(@Amount AS NVARCHAR(20)) + '=
' transferred.'';
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;
        PRINT ''Transfer failed. Error: '' + ERROR_MESSAGE();
    END CATCH
END;
');

EXEC sp_TransferMoney @FromAccount =3D 1, @ToAccount =3D 2, @Amount =3D 100=
.00;
