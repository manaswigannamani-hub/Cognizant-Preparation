CREATE TABLE Sales (
    SaleID INT PRIMARY KEY IDENTITY(1,1),
    SaleDate DATE,
    Product NVARCHAR(50),
    Region NVARCHAR(50),
    Amount DECIMAL(10,2)
);
INSERT INTO Sales VALUES
('2024-01-05', 'Laptop', 'North', 5000),
('2024-01-10', 'Mouse', 'North', 50),
('2024-01-15', 'Laptop', 'South', 5000),
('2024-01-20', 'Keyboard', 'South', 100),
('2024-02-05', 'Laptop', 'East', 5000),
('2024-02-10', 'Mouse', 'East', 50),
('2024-02-15', 'Monitor', 'West', 300),
('2024-02-20', 'Keyboard', 'West', 100),
('2024-03-05', 'Laptop', 'North', 5000),
('2024-03-10', 'Monitor', 'South', 300);
-- 1. Standard Group By
SELECT=20
    Product,
    Region,
    SUM(Amount) AS TotalSales
FROM Sales
GROUP BY Product, Region
ORDER BY Product, Region;
-- 2. ROLLUP (Creates hierarchical sub-totals and grand totals)
SELECT=20
    Product,
    Region,
    SUM(Amount) AS TotalSales
FROM Sales
GROUP BY ROLLUP (Product, Region);
-- 3. CUBE (Generates sub-totals for every possible combination of columns)
SELECT=20
    Product,
    Region,
    SUM(Amount) AS TotalSales
FROM Sales
GROUP BY CUBE (Product, Region);
-- 4. GROUPING SETS (Allows custom aggregation layouts)
SELECT=20
    Product,
    Region,
    SUM(Amount) AS TotalSales
FROM Sales
GROUP BY GROUPING SETS (
    (Product, Region),
    (Product),
    (Region),
    ()
);
-- 5. Using ISNULL and GROUPING to make sub-total labels clean
SELECT=20
    ISNULL(Product, 'Total') AS Product,
    ISNULL(Region, 'Total') AS Region,
    SUM(Amount) AS TotalSales,
    GROUPING(Product) AS ProductGrouping,
    GROUPING(Region) AS RegionGrouping
FROM Sales
GROUP BY ROLLUP (Product, Region)
ORDER BY Product, Region;
-- 6. Date Rollup hierarchy (Year -&gt; Month -&gt; Product sub-totals)
SELECT=20
    YEAR(SaleDate) AS Year,
    MONTH(SaleDate) AS Month,
    Product,
    SUM(Amount) AS MonthlySales
FROM Sales
GROUP BY ROLLUP (YEAR(SaleDate), MONTH(SaleDate), Product);
