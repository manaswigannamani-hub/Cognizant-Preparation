EXEC('
CREATE PROCEDURE sp_DemoDeadlock
    @Account1 INT,
    @Account2 INT
AS
BEGIN
    BEGIN TRANSACTION;
    BEGIN TRY
        UPDATE AccountBalance SET Balance =3D Balance - 50 WHERE AccountID =
=3D @Account1;
        WAITFOR DELAY ''00:00:02'';
        UPDATE AccountBalance SET Balance =3D Balance + 50 WHERE AccountID =
=3D @Account2;
       =20
        COMMIT TRANSACTION;
        PRINT ''Transaction completed successfully'';
    END TRY
    BEGIN CATCH
        IF ERROR_NUMBER() =3D 1205
        BEGIN
            PRINT ''Deadlock detected. Retrying transaction...'';
            ROLLBACK TRANSACTION;
            WAITFOR DELAY ''00:00:01'';
        END
        ELSE
        BEGIN
            PRINT ''Error: '' + ERROR_MESSAGE();
            ROLLBACK TRANSACTION;
        END
    END CATCH
END;
');
