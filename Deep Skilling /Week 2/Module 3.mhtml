-- 1. Standard CTE: Find the top 2 highest-paid employees in each departmen=
t
WITH EmployeeSalaryRank AS (
    SELECT=20
        EmployeeID,
        FirstName,
        LastName,
        Department,
        Salary,
        RANK() OVER (PARTITION BY Department ORDER BY Salary DESC) AS Salar=
yRank
    FROM Employees
)
SELECT=20
    EmployeeID,
    FirstName,
    LastName,
    Department,
    Salary,
    SalaryRank
FROM EmployeeSalaryRank
WHERE SalaryRank &lt;=3D 2;
-- 2. Multiple CTEs combined: Segment employees by salary bands
WITH HighEarners AS (
    SELECT=20
        EmployeeID,
        FirstName,
        LastName,
        Salary,
        'High' AS SalaryCategory
    FROM Employees
    WHERE Salary &gt; 70000
),
MidEarners AS (
    SELECT=20
        EmployeeID,
        FirstName,
        LastName,
        Salary,
        'Mid' AS SalaryCategory
    FROM Employees
    WHERE Salary BETWEEN 50000 AND 70000
),
LowEarners AS (
    SELECT=20
        EmployeeID,
        FirstName,
        LastName,
        Salary,
        'Low' AS SalaryCategory
    FROM Employees
    WHERE Salary &lt; 50000
)
SELECT * FROM HighEarners
UNION ALL
SELECT * FROM MidEarners
UNION ALL
SELECT * FROM LowEarners
ORDER BY Salary DESC;
-- 3. Recursive CTE: Establish an organizational chart hierarchy
CREATE TABLE Organization (
    EmployeeID INT PRIMARY KEY,
    EmployeeName NVARCHAR(50),
    ManagerID INT NULL,
    Department NVARCHAR(50)
);
INSERT INTO Organization VALUES
(1, 'CEO', NULL, 'Executive'),
(2, 'VP Sales', 1, 'Sales'),
(3, 'VP IT', 1, 'IT'),
(4, 'Sales Manager', 2, 'Sales'),
(5, 'IT Manager', 3, 'IT'),
(6, 'Sales Rep', 4, 'Sales'),
(7, 'IT Developer', 5, 'IT'),
(8, 'IT Developer', 5, 'IT');
WITH EmployeeHierarchy AS (
    SELECT=20
        EmployeeID,
        EmployeeName,
        ManagerID,
        Department,
        0 AS HierarchyLevel
    FROM Organization
    WHERE ManagerID IS NULL
    UNION ALL
    SELECT=20
        org.EmployeeID,
        org.EmployeeName,
        org.ManagerID,
        org.Department,
        eh.HierarchyLevel + 1
    FROM Organization org
    INNER JOIN EmployeeHierarchy eh ON org.ManagerID =3D eh.EmployeeID
)
SELECT=20
    EmployeeID,
    REPLICATE('  ', HierarchyLevel) + EmployeeName AS EmployeeName,
    ManagerID,
    Department,
    HierarchyLevel
FROM EmployeeHierarchy
ORDER BY HierarchyLevel, EmployeeID;
-- 4. Recursive CTE: Generate a sequence of sequential numbers
WITH RecursiveNumbers AS (
    SELECT 1 AS Number=20
    UNION ALL =20
    SELECT Number + 1
    FROM RecursiveNumbers
    WHERE Number &lt; 10
)
SELECT Number FROM RecursiveNumbers;
-- 5. Recursive CTE: Dynamically generate an entire calendar range of dates
WITH DateRange AS (
    SELECT CAST('2024-01-01' AS DATE) AS DateValue
    UNION ALL
    SELECT DATEADD(DAY, 1, DateValue)
    FROM DateRange
    WHERE DateValue &lt; '2024-01-31'
)
SELECT DateValue FROM DateRange;
