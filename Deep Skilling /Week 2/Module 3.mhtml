-- 1. Create Source and Target tables for the MERGE demonstration
CREATE TABLE SourceEmployees (
    EmployeeID INT,
    FirstName NVARCHAR(50),
    LastName NVARCHAR(50),
    Department NVARCHAR(50),
    Salary DECIMAL(10,2)
);
INSERT INTO SourceEmployees VALUES
(1, 'John', 'Smith', 'Sales', 51000),
(2, 'Jane', 'Doe', 'Sales', 56000),
(9, 'David', 'Lee', 'Finance', 60000);
CREATE TABLE TargetEmployees (
    EmployeeID INT PRIMARY KEY,
    FirstName NVARCHAR(50),
    LastName NVARCHAR(50),
    Department NVARCHAR(50),
    Salary DECIMAL(10,2)
);
-- Pre-populating target data with explicit values so it doesn't rely on Ex=
ercise 1
INSERT INTO TargetEmployees VALUES=20
(1, 'John', 'Smith', 'Sales', 50000),
(2, 'Jane', 'Doe', 'Sales', 55000),
(3, 'Mike', 'Johnson', 'IT', 75000);
-- Execute MERGE (Updates matching records, inserts missing ones)
MERGE TargetEmployees AS target
USING SourceEmployees AS source
ON target.EmployeeID =3D source.EmployeeID
WHEN MATCHED THEN
    UPDATE SET=20
        FirstName =3D source.FirstName,
        LastName =3D source.LastName,
        Department =3D source.Department,
        Salary =3D source.Salary
WHEN NOT MATCHED THEN
    INSERT (EmployeeID, FirstName, LastName, Department, Salary)
    VALUES (source.EmployeeID, source.FirstName, source.LastName, source.De=
partment, source.Salary);
SELECT * FROM TargetEmployees;
-- 2. UNPIVOT Demonstration (Converting Columns to Rows)
CREATE TABLE QuarterlySales (
    Employee NVARCHAR(50),
    Q1 DECIMAL(10,2),
    Q2 DECIMAL(10,2),
    Q3 DECIMAL(10,2),
    Q4 DECIMAL(10,2)
);
INSERT INTO QuarterlySales VALUES
('John', 10000, 12000, 11000, 13000),
('Jane', 15000, 14000, 16000, 17000),
('Mike', 12000, 13000, 12500, 14000);
SELECT Employee, Q1, Q2, Q3, Q4 FROM QuarterlySales;
SELECT *
FROM QuarterlySales
UNPIVOT (
    Amount FOR Quarter IN (Q1, Q2, Q3, Q4)
) AS unpvt
ORDER BY Employee, Quarter;
-- 3. PIVOT Demonstration (Converting Rows to Columns)
CREATE TABLE MonthlySalesUnpivoted (
    Employee NVARCHAR(50),
    Month NVARCHAR(10),
    Sales DECIMAL(10,2)
);
INSERT INTO MonthlySalesUnpivoted VALUES
('John', 'Q1', 10000),
('John', 'Q2', 12000),
('John', 'Q3', 11000),
('John', 'Q4', 13000),
('Jane', 'Q1', 15000),
('Jane', 'Q2', 14000),
('Jane', 'Q3', 16000),
('Jane', 'Q4', 17000);
SELECT *
FROM MonthlySalesUnpivoted
PIVOT (
    SUM(Sales) FOR Month IN ([Q1], [Q2], [Q3], [Q4])
) AS pvt
ORDER BY Employee;
-- Final PIVOT calculation query with an inline evaluation
SELECT=20
    Employee,
    [Q1] AS Q1,
    [Q2] AS Q2,
    [Q3] AS Q3,
    [Q4] AS Q4,
    ([Q1] + [Q2] + [Q3] + [Q4]) AS AnnualSales
FROM MonthlySalesUnpivoted
PIVOT (
    SUM(Sales) FOR Month IN ([Q1], [Q2], [Q3], [Q4])
) AS pvt;
