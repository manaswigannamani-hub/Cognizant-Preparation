-- STEP 4: Create tr_EmployeeInsert (AFTER INSERT Trigger)
-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
EXEC('
CREATE TRIGGER tr_EmployeeInsert
ON Employees
AFTER INSERT
AS
BEGIN
    INSERT INTO EmployeeAudit (EmployeeID, Action, NewSalary, ChangeDate, C=
hangedBy)
    SELECT=20
        EmployeeID,
        ''INSERT'',
        Salary,
        GETDATE(),
        SYSTEM_USER
    FROM inserted;
END;
');


-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
-- STEP 5: Create tr_PreventHighSalaryIncrease (INSTEAD OF UPDATE Trigger)
-- =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
EXEC('
CREATE TRIGGER tr_PreventHighSalaryIncrease
ON Employees
INSTEAD OF UPDATE
AS
BEGIN
    IF UPDATE(Salary)
    BEGIN
        DECLARE @MaxIncrease DECIMAL(5,2) =3D 0.20;
       =20
        IF EXISTS (
            SELECT 1
            FROM inserted i
            INNER JOIN deleted d ON i.EmployeeID =3D d.EmployeeID
            WHERE (i.Salary - d.Salary) / d.Salary &gt; @MaxIncrease
        )
        BEGIN
            PRINT ''Salary increase cannot exceed 20% in a single update'';
            RETURN;
        END
       =20
        UPDATE Employees
        SET=20
            FirstName =3D i.FirstName,
            LastName =3D i.LastName,
            Department =3D i.Department,
            Salary =3D i.Salary,
            HireDate =3D i.HireDate
        FROM inserted i
        WHERE Employees.EmployeeID =3D i.EmployeeID;
    END
END;
');


